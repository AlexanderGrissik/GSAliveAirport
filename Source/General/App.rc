#include "Source\\UI\\resources.h"
#include <winver.h>

IDR_APP_ICON ICON "Source\\UI\\Logo.ico"
IDR_UI_HTML RCDATA "Source\\UI\\index.html"
IDR_UI_CSS RCDATA "Source\\UI\\style.css"
IDR_UI_JS RCDATA "Source\\UI\\app.js"
IDR_UI_LOGO RCDATA "Source\\UI\\Logo.png"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
  PRODUCTVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
  FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
  FILEFLAGS      0x0L
  FILEOS         VOS_NT_WINDOWS32
  FILETYPE       VFT_APP
  FILESUBTYPE    VFT2_UNKNOWN
  BEGIN
    BLOCK "StringFileInfo"
    BEGIN
      BLOCK "040904b0"
      BEGIN
        VALUE "CompanyName",      "Alexander Grissik"
        VALUE "FileDescription",  "GSAliveAirport"
        VALUE "FileVersion",      APP_VERSION
        VALUE "InternalName",     "GSAliveAirport"
        VALUE "LegalCopyright",   "Copyright (c) 2026 Alexander Grissik"
        VALUE "OriginalFilename", "GSAliveAirport.exe"
        VALUE "ProductName",      "GSAliveAirport"
        VALUE "ProductVersion",   APP_VERSION
      END
    END
    BLOCK "VarFileInfo"
    BEGIN
      VALUE "Translation", 0x0409, 1200
    END
  END